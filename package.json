{
  "name": "stex",
  "private": true,
  "version": "0.1.0",
  "description": "Local monorepo for the STEX graph applications",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=9.15.9"
  },
  "scripts": {
    "build:seaxneat": "corepack pnpm --dir apps/seaxneat build",
    "build:igor": "corepack pnpm --dir stex-igor/apps/igor build",
    "dev:alpha": "node scripts/dev-alpha.mjs",
    "check:prereqs": "node scripts/check-prereqs.mjs",
    "dev:pantheon": "corepack pnpm --dir apps/pantheon dev",
    "dev:frige": "corepack pnpm --dir apps/frige dev",
    "dev:seaxneat": "corepack pnpm --dir apps/seaxneat dev",
    "dev:igor": "corepack pnpm --dir stex-igor/apps/igor dev",
    "dev:inference": "corepack pnpm --dir stex-igor/services/inference dev",
    "assets:build": "node scripts/assets/build-media.mjs",
    "verify:splash": "node scripts/verify-splash.mjs",
    "verify:home": "node scripts/verify-home.mjs",
    "verify:igor": "node scripts/verify-igor.mjs",
    "verify:igor-login": "node scripts/verify-igor-login.mjs",
    "verify:frige": "node scripts/verify-frige.mjs",
    "check:hermes-runtime": "node stex-igor/hermes/src/reconcile-runtime-profiles.mjs",
    "test": "corepack pnpm run test:assets && corepack pnpm run test:design-system && corepack pnpm run test:pantheon && corepack pnpm run test:igor && corepack pnpm run test:frige && corepack pnpm run test:inference && corepack pnpm run test:seaxneat && corepack pnpm run test:hermes && corepack pnpm run test:knowledge && corepack pnpm run test:stex-igor-sync",
    "test:assets": "node --test scripts/assets/verify-assets.test.mjs",
    "test:design-system": "corepack pnpm --dir packages/design-system test",
    "test:inference": "corepack pnpm --dir stex-igor/services/inference test",
    "test:hermes": "node --test stex-igor/hermes/test/roster.test.mjs stex-igor/hermes/test/runtime-profiles.test.mjs",
    "test:knowledge": "corepack pnpm --dir services/knowledge test",
    "test:pantheon": "corepack pnpm --dir apps/pantheon test",
    "test:igor": "corepack pnpm --dir stex-igor/apps/igor test",
    "test:stex-igor-sync": "node scripts/sync-stex-igor.mjs --check",
    "sync:stex-igor": "node scripts/sync-stex-igor.mjs",
    "test:frige": "corepack pnpm --dir apps/frige test",
    "test:seaxneat": "corepack pnpm --dir apps/seaxneat test",
    "dev:lab": "corepack pnpm run dev:pantheon",
    "dev:texgraph": "corepack pnpm run dev:frige",
    "test:lab": "corepack pnpm run test:pantheon",
    "test:texgraph": "corepack pnpm run test:frige",
    "build:pantheon": "corepack pnpm --dir apps/pantheon build",
    "verify:platform": "node scripts/verify-platform.mjs"
  }
}
