{
  "name": "stex",
  "private": true,
  "version": "0.1.0",
  "description": "Local monorepo for the STEX graph applications",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=9.15.9"
  },
  "scripts": {
    "build:seaxneat": "corepack pnpm --dir apps/seaxneat build",
    "dev:alpha": "node scripts/dev-alpha.mjs",
    "dev:lab": "corepack pnpm --dir apps/lab dev",
    "dev:seaxneat": "corepack pnpm --dir apps/seaxneat dev",
    "dev:texgraph": "corepack pnpm --dir apps/texgraph dev",
    "dev:inference": "corepack pnpm --dir services/inference dev",
    "test": "corepack pnpm run test:lab && corepack pnpm run test:texgraph && corepack pnpm run test:inference && corepack pnpm run test:seaxneat",
    "test:inference": "corepack pnpm --dir services/inference test",
    "test:lab": "corepack pnpm --dir apps/lab test",
    "test:seaxneat": "corepack pnpm --dir apps/seaxneat test",
    "test:texgraph": "corepack pnpm --dir apps/texgraph test"
  }
}
