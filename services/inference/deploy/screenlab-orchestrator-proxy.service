[Unit]
Description=Private relay to the ScreenLab Hermes orchestrator
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=editor_stexpedite_press
WorkingDirectory=/home/editor_stexpedite_press
ExecStart=/usr/bin/python3 /opt/stex-inference/cloud_run_relay.py
Restart=always
RestartSec=5
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
