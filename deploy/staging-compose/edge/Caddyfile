# Staging TLS edge for compose.hosted.yaml: stands in for the Cloudflare Tunnel.
# Terminates HTTPS with Caddy's local CA and forwards to Pantheon on the internal network.
{
	admin off
	auto_https disable_redirects
	skip_install_trust
}

https://pantheon.stex.test:8443 {
	tls internal
	reverse_proxy pantheon:4300
}

# Any other Host on this listener is refused, as the tunnel's catch-all ingress rule does.
https://:8443 {
	tls internal {
		on_demand
	}
	respond "Misdirected request" 421
}
