{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stexpedite.press/protocol/frige/passages.v1.schema.json",
  "title": "Frige passages v1 (stex.frige.passages.v1)",
  "description": "Read-only passages of author-approved attachment excerpts. Frige is the only producer. Definitions only; see protocol/frige/README.md, Passages v1.",
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["application", "id", "reference", "title"],
      "properties": {
        "application": { "const": "frige" },
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$" },
        "reference": { "type": "string", "pattern": "^stex://frige/project/[a-z0-9][a-z0-9-]{0,62}$" },
        "title": { "type": "string" }
      }
    },
    "citation": {
      "type": "object",
      "required": ["reference", "attachmentId", "title", "originalSha256", "excerptHash", "start", "end", "passageSha256"],
      "properties": {
        "reference": { "type": "string", "pattern": "^stex://frige/project/[a-z0-9][a-z0-9-]{0,62}#attachment=[a-f0-9]{16}$" },
        "attachmentId": { "type": "string", "pattern": "^[a-f0-9]{16}$" },
        "title": { "type": "string" },
        "originalSha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
        "excerptHash": { "$ref": "#/$defs/sha256" },
        "start": { "type": "integer", "minimum": 0 },
        "end": { "type": "integer", "minimum": 1 },
        "passageSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "searchHit": {
      "allOf": [{ "$ref": "#/$defs/citation" }],
      "type": "object",
      "required": ["snippet"],
      "properties": { "snippet": { "type": "string", "maxLength": 242 } }
    },
    "searchResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "project", "passages", "truncated"],
      "properties": {
        "schemaVersion": { "const": "stex.frige.passages.v1" },
        "project": { "$ref": "#/$defs/project" },
        "passages": { "type": "array", "maxItems": 20, "items": { "$ref": "#/$defs/searchHit" } },
        "truncated": { "type": "boolean" }
      }
    },
    "readResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "project", "passage"],
      "properties": {
        "schemaVersion": { "const": "stex.frige.passages.v1" },
        "project": { "$ref": "#/$defs/project" },
        "passage": {
          "allOf": [{ "$ref": "#/$defs/citation" }],
          "type": "object",
          "required": ["text"],
          "properties": { "text": { "type": "string" } }
        }
      }
    },
    "error": {
      "type": "object",
      "required": ["error"],
      "properties": {
        "error": { "type": "string" },
        "code": { "enum": ["INVALID_REQUEST", "NOT_FOUND", "STALE_PASSAGE", "PROJECT_LOCKED", "UNAVAILABLE", "FORBIDDEN"] }
      }
    }
  }
}
