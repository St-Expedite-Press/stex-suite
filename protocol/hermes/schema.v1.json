{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "stex.hermes.turn.v1",
  "title": "STEX Hermes turn v1",
  "type": "object",
  "required": ["contract", "requestId", "product", "conversation", "operation", "budget"],
  "properties": {
    "contract": { "const": "stex.hermes.turn.v1" },
    "requestId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$" },
    "product": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,39}$" },
    "conversation": { "type": "object", "required": ["messages"], "properties": { "id": { "type": "string", "maxLength": 80 }, "messages": { "type": "array", "minItems": 1, "maxItems": 20 } } },
    "operation": { "type": "object", "required": ["kind"], "properties": { "kind": { "enum": ["conversation", "proposal", "edit", "cancel"] }, "payload": {} } },
    "context": { "type": "object" },
    "budget": { "type": "object", "required": ["maxContextChars", "maxOutputChars", "timeoutMs"], "properties": { "maxContextChars": { "type": "integer", "minimum": 1 }, "maxOutputChars": { "type": "integer", "minimum": 1 }, "timeoutMs": { "type": "integer", "minimum": 1 } } }
  }
}
