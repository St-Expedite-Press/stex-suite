{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "stex.hermes.turn-response.v1",
  "title": "STEX Hermes turn response v1",
  "type": "object",
  "required": ["contract", "requestId", "status", "events", "usage"],
  "properties": {
    "contract": { "const": "stex.hermes.turn.v1" },
    "requestId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$" },
    "status": { "enum": ["completed", "cancelled"] },
    "events": {
      "type": "array",
      "maxItems": 40,
      "items": {
        "type": "object",
        "required": ["sequence", "type", "payload"],
        "properties": { "sequence": { "type": "integer", "minimum": 1 }, "type": { "enum": ["message", "proposal", "status"] }, "payload": { "type": "object" } }
      }
    },
    "usage": { "type": "object", "required": ["inputChars", "outputChars", "transport"], "properties": { "inputChars": { "type": "integer", "minimum": 0 }, "outputChars": { "type": "integer", "minimum": 0 }, "transport": { "type": "string" } } }
  }
}
