{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stexpedite.press/protocol/knowledge/api.v1.schema.json",
  "title": "Knowledge host API v1 (stex.knowledge.projections.v1 over HTTP)",
  "description": "Request bodies and the error, disabled and view shapes of /api/knowledge/v1, served identically by Pantheon's Node host and the platform API. Definitions only; see protocol/knowledge/README.md.",
  "$defs": {
    "idempotencyKey": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{7,79}$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "projectReference": { "type": "string", "pattern": "^stex://(frige|seaxneat)/project/[a-z0-9][a-z0-9-]{0,62}$" },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["error", "code"],
      "properties": {
        "error": { "type": "string" },
        "code": {
          "type": "string",
          "description": "Stable code. Includes INVALID_REQUEST, SIGN_IN_REQUIRED, STALE_KNOWLEDGE, STALE_EVENT, EVENT_CONFLICT, KEY_CONFLICT, KNOWLEDGE_LIMIT, KNOWLEDGE_LOCKED, KNOWLEDGE_UNAVAILABLE, INVALID_JOURNAL, NOT_FOUND, STALE_PASSAGE, ALREADY_CONTRIBUTED, ALREADY_WITHDRAWN, CONTRIBUTION_WITHDRAWN, VAULT_LOCAL_ONLY, VAULT_DISABLED, FORBIDDEN, KNOWLEDGE_MISCONFIGURED."
        }
      }
    },
    "disabled": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": { "enabled": { "const": false } }
    },
    "view": {
      "type": "object",
      "required": ["enabled", "version", "knowledge", "graph"],
      "properties": {
        "enabled": { "const": true },
        "version": { "type": "string" },
        "knowledge": {
          "type": "object",
          "required": ["sources"],
          "properties": { "sources": { "type": "array", "items": { "type": "object", "required": ["id", "reference", "revision", "project"] } } }
        },
        "graph": {
          "type": "object",
          "required": ["projects", "relations"],
          "properties": { "projects": { "type": "array" }, "relations": { "type": "array" } }
        },
        "legacyJournal": { "const": "unassigned" },
        "replayed": { "type": "boolean" }
      }
    },
    "export": {
      "type": "object",
      "required": ["enabled", "version", "knowledge", "graph", "journal"],
      "properties": { "journal": { "type": "object", "required": ["schemaVersion", "generation", "events"] } }
    },
    "sources": {
      "type": "object",
      "required": ["schemaVersion", "project", "sources"],
      "properties": { "schemaVersion": { "const": "stex.project.context.v1" }, "sources": { "type": "array", "maxItems": 50 } }
    },
    "acceptRequest": {
      "type": "object",
      "required": ["idempotencyKey", "expectedVersion", "project", "sources"],
      "properties": {
        "idempotencyKey": { "$ref": "#/$defs/idempotencyKey" },
        "expectedVersion": { "type": "string" },
        "project": { "$ref": "#/$defs/projectReference" },
        "sources": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": { "type": "object", "required": ["id", "revision"], "properties": { "id": { "type": "string" }, "revision": { "$ref": "#/$defs/sha256" } } }
        }
      }
    },
    "revokeRequest": {
      "type": "object",
      "required": ["idempotencyKey", "expectedVersion", "project"],
      "properties": { "idempotencyKey": { "$ref": "#/$defs/idempotencyKey" }, "expectedVersion": { "type": "string" }, "project": { "$ref": "#/$defs/projectReference" } }
    },
    "relationRequest": {
      "type": "object",
      "required": ["idempotencyKey", "expectedVersion", "relation"],
      "properties": { "idempotencyKey": { "$ref": "#/$defs/idempotencyKey" }, "expectedVersion": { "type": "string" }, "relation": { "type": "object", "required": ["id", "kind", "subject", "predicate", "object", "evidence"] } }
    },
    "reviseRequest": {
      "type": "object",
      "required": ["idempotencyKey", "expectedVersion", "id", "status"],
      "properties": { "idempotencyKey": { "$ref": "#/$defs/idempotencyKey" }, "expectedVersion": { "type": "string" }, "id": { "type": "string" }, "status": { "enum": ["accepted", "rejected"] }, "object": { "type": "string" } }
    },
    "eraseRequest": {
      "type": "object",
      "required": ["expectedVersion", "confirmation"],
      "properties": { "expectedVersion": { "type": "string" }, "confirmation": { "const": "delete-knowledge" } }
    }
  }
}
