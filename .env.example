# STEX Suite configuration template. Copy to .env and fill only the values
# required for the components you run. .env is ignored by Git.

STEX_ENV=development
STEX_LOG_LEVEL=info
STEX_WEB_ORIGIN=http://127.0.0.1:3000
STEX_API_HOST=127.0.0.1
STEX_API_PORT=8000
STEX_INFERENCE_HOST=127.0.0.1
STEX_INFERENCE_PORT=8100
STEX_INFERENCE_URL=http://127.0.0.1:8100
STEX_INFERENCE_SHARED_SECRET=replace-with-a-long-random-value

# Inference service only. The gateway forwards bounded TexGraph envelopes to
# the existing private Hermes director; do not expose these to browser/apps.
SCREENLAB_ORCHESTRATOR_URL=
SCREENLAB_ORCHESTRATOR_KEY=replace-with-the-private-hermes-internal-key
# OpenRouter stays behind the Hermes director, never in TexGraph processes.
OPENROUTER_API_KEY=configure-only-in-the-private-hermes-runtime
GOOGLE_FONTS_API_KEY=replace-with-a-restricted-web-fonts-developer-api-key
STEX_INFERENCE_MAX_INPUT_TOKENS=24000
STEX_INFERENCE_REQUEST_TIMEOUT_SECONDS=120

# Shared knowledge base; never use it for app state or secrets.
STEX_OBSIDIAN_VAULT_PATH=
STEX_VAULT_READ_ONLY=false
STEX_DATA_DIR=
STEX_ARTIFACTS_DIR=
STEX_LOG_DIR=

# Future deployment configuration only; this template performs no deployment.
GOOGLE_CLOUD_PROJECT=central-nerve-machine
GOOGLE_CLOUD_REGION=us-central1
STEX_GCP_INFERENCE_SERVICE_NAME=stex-inference
GOOGLE_APPLICATION_CREDENTIALS=
REPLIT_DEPLOYMENT_TARGET=
REPLIT_APP_URL=

STEX_OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
