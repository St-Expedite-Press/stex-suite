# STEX Pantheon local configuration template. Copy to ignored .env as needed.

STEX_PANTHEON_PORT=4300
STEX_FRIGE_PORT=4310
SEAXNEAT_PORT=4320
# Igor (apps/igor) listens on 4330 and keeps conversations in apps/igor/.local-data/ by default.
# STEX_IGOR_PORT=4330
# STEX_IGOR_DATA_DIR=
STEX_INFERENCE_PORT=8100
STEX_INFERENCE_URL=http://127.0.0.1:8100
STEX_INFERENCE_SHARED_SECRET=replace-with-a-long-random-local-value

# Canonical Frige data locations are optional. When unset, Frige preserves an
# existing legacy local-data directory rather than moving it automatically.
STEX_FRIGE_PROJECT_DIR=
STEX_FRIGE_PROJECTS_DIR=
STEX_FRIGE_BOOKS_DIR=

# Inference remains server-side. `fake` is the safe local default. `remote`
# targets the local upstream Hermes API; never place an OpenRouter key here.
STEX_HERMES_TRANSPORT=fake
STEX_HERMES_URL=http://127.0.0.1:8642
# Must match API_SERVER_KEY in the ignored Igor runtime environment.
STEX_HERMES_API_KEY=
STEX_HERMES_API_MODE=chat-completions
STEX_HERMES_MODEL=hermes-agent
# Remote turns fail closed until an administrator explicitly acknowledges an
# independently verified OS/container boundary and enables the
# conversational-only policy. The flags cannot prove that boundary.
STEX_HERMES_ISOLATION=
STEX_HERMES_TOOL_POLICY=conversational-only
STEX_HERMES_MAX_CONTEXT_CHARS=96000
STEX_HERMES_MAX_OUTPUT_CHARS=20000
STEX_HERMES_MAX_TIMEOUT_SECONDS=60
STEX_HERMES_MAX_CONCURRENT_TURNS=1

# Upstream Hermes owns these values in the ignored Igor profile environment
# (%LOCALAPPDATA%\hermes\profiles\igor\.env on native Windows). Do not copy
# them to STEX.
# OPENROUTER_API_KEY=
# API_SERVER_ENABLED=true
# API_SERVER_KEY=

# The optional User Graph is disabled when this is unset. It is read-only.
STEX_VAULT_PATH=
